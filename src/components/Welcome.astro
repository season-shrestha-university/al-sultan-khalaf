---
import Image from "astro/components/Image.astro";
---

<div id="container">
  <main>
    <section>
      <Image class="logo" src="/logo.svg" alt="" width={1440} height={960} />
    </section>
  </main>
</div>

<style>
  #container {
    height: 100vh;
    width: 100vw;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo {
    width: 800px;
    height: 800px;
  }
</style>
