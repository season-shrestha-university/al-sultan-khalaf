---
/* Header Component - Al-Sultan & Khalaf Trading Co */
---

<header class="header" id="site-header">
  <div class="header__container container">
    <!-- Logo -->
    <a
      href="/"
      class="header__logo"
      aria-label="Al-Sultan & Khalaf Trading Co - Home"
    >
      <img
        src="/logo.svg"
        alt="Al-Sultan & Khalaf Trading Co Logo"
        class="header__logo-img"
        width="262"
        height="60"
      />
    </a>

    <!-- Mobile Menu Toggle -->
    <button
      class="header__menu-toggle"
      id="menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span class="header__menu-bar"></span>
      <span class="header__menu-bar"></span>
      <span class="header__menu-bar"></span>
    </button>

    <!-- Navigation -->
    <nav class="header__nav" id="main-nav" aria-label="Main navigation">
      <ul class="header__nav-list">
        <li class="header__nav-item">
          <a href="/" class="header__nav-link header__nav-link--active">Home</a>
        </li>
        <li class="header__nav-item">
          <a href="/about" class="header__nav-link">About</a>
        </li>
        <li class="header__nav-item">
          <a href="/divisions" class="header__nav-link">Divisions</a>
        </li>
        <li class="header__nav-item">
          <a href="/contact" class="header__nav-link">Contact</a>
        </li>
        <li class="header__nav-item">
          <a
            href="/shop"
            class="header__nav-link header__nav-link--external"
            target="_blank"
            rel="noopener noreferrer"
          >
            Shop
            <svg
              class="header__external-icon"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              ></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* ==========================================================================
     Block: header
     ========================================================================== */
  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  /* Element: header__container */
  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  /* Element: header__logo */
  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .header__logo:hover {
    opacity: 0.85;
  }

  /* Element: header__logo-img */
  .header__logo-img {
    height: 48px;
    width: auto;
  }

  /* Element: header__menu-toggle */
  .header__menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: var(--space-1);
    z-index: 110;
  }

  /* Element: header__menu-bar */
  .header__menu-bar {
    display: block;
    width: 100%;
    height: 2.5px;
    background: var(--color-dark);
    border-radius: var(--radius-full);
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  /* Element: header__nav */
  .header__nav {
    display: flex;
    align-items: center;
  }

  /* Element: header__nav-list */
  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Element: header__nav-item */
  .header__nav-item {
    position: relative;
  }

  /* Element: header__nav-link */
  .header__nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--color-gray-700);
    border-radius: var(--radius-sm);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
    position: relative;
  }

  .header__nav-link:hover {
    color: var(--color-primary);
  }

  /* Modifier: header__nav-link--active */
  .header__nav-link--active {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Modifier: header__nav-link--external */
  .header__nav-link--external {
    font-weight: 700;
    color: var(--color-dark);
  }

  .header__nav-link--external:hover {
    color: var(--color-primary);
  }

  /* Element: header__external-icon */
  .header__external-icon {
    margin-left: 2px;
    transition: transform var(--transition-fast);
  }

  .header__nav-link--external:hover .header__external-icon {
    transform: translate(2px, -2px);
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .header__menu-toggle {
      display: flex;
    }

    .header__nav {
      position: fixed;
      top: 0;
      right: 0;
      width: 280px;
      height: 100vh;
      background: var(--color-white);
      box-shadow: var(--shadow-xl);
      flex-direction: column;
      justify-content: center;
      transform: translateX(100%);
      transition: transform var(--transition-slow);
      z-index: 105;
    }

    .header__nav--open {
      transform: translateX(0);
    }

    .header__nav-list {
      flex-direction: column;
      gap: var(--space-4);
    }

    .header__nav-link {
      font-size: var(--font-size-lg);
      padding: var(--space-3) var(--space-6);
    }

    /* Hamburger animation when open */
    .header__menu-toggle--active .header__menu-bar:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .header__menu-toggle--active .header__menu-bar:nth-child(2) {
      opacity: 0;
    }
    .header__menu-toggle--active .header__menu-bar:nth-child(3) {
      transform: rotate(-45deg) translate(6px, -6px);
    }
  }
</style>

<script>
  // Mobile menu toggle
  const menuToggle = document.getElementById("menu-toggle");
  const mainNav = document.getElementById("main-nav");

  if (menuToggle && mainNav) {
    menuToggle.addEventListener("click", () => {
      const isOpen = mainNav.classList.toggle("header__nav--open");
      menuToggle.classList.toggle("header__menu-toggle--active");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
    });
  }
</script>
