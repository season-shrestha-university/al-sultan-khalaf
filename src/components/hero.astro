---
/* Hero Component - Full-width banner with CTA */
---

<section class="hero" id="hero-section">
  <div class="hero__overlay"></div>

  <div class="hero__content container">
    <span class="hero__subtitle">SINCE 1973</span>
    <h1 class="hero__title">WE'VE EARNED THE TRUST</h1>
    <div class="hero__actions">
      <a href="/contact" class="hero__cta">CONTACT US</a>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     Block: hero
     ========================================================================== */
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: url("/banner.png");
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  /* Element: hero__overlay */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.25) 40%,
      rgba(0, 0, 0, 0.45) 100%
    );
    z-index: 1;
  }

  /* Element: hero__content */
  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding-top: var(--header-height);
  }

  /* Element: hero__subtitle */
  .hero__subtitle {
    display: inline-block;
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-white);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: heroFadeUp 0.8s ease both;
    animation-delay: 0.2s;
  }

  /* Element: hero__title */
  .hero__title {
    font-size: var(--font-size-hero);
    font-weight: 900;
    color: var(--color-white);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    max-width: 800px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    animation: heroFadeUp 0.8s ease both;
    animation-delay: 0.4s;
  }

  /* Element: hero__actions */
  .hero__actions {
    animation: heroFadeUp 0.8s ease both;
    animation-delay: 0.6s;
  }

  /* Element: hero__cta */
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-10);
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-white);
    background: var(--color-primary);
    border-radius: var(--radius-full);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    box-shadow: 0 4px 20px rgba(230, 57, 70, 0.35);
  }

  .hero__cta:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(230, 57, 70, 0.5);
  }

  .hero__cta:active {
    transform: translateY(0);
    box-shadow: 0 2px 12px rgba(230, 57, 70, 0.3);
  }

  /* --- Animations --- */
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .hero {
      min-height: 70vh;
    }

    .hero__title {
      font-size: clamp(1.75rem, 7vw, 3rem);
    }

    .hero__subtitle {
      font-size: var(--font-size-base);
    }

    .hero__cta {
      padding: var(--space-3) var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 60vh;
    }

    .hero__content {
      gap: var(--space-4);
    }
  }
</style>
